+def test_retries_give_up_after_max_retries(tmp_path):
+    client, calls = fake_client(tmp_path, [500])
+    with pytest.raises(TransientAPIError):
+        client.segment_row_raw(b"png", "stone")
+    assert len(calls) == client.max_retries + 1
